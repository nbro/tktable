# Tests tktable with Ubuntu's own Python, Tk and Tktable (package tk-table).
FROM ubuntu:24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-venv python3-tk tk-table xvfb \
    && rm -rf /var/lib/apt/lists/*

# --system-site-packages: tkinter comes from the distro package python3-tk.
RUN python3 -m venv --system-site-packages /venv
ENV PATH="/venv/bin:$PATH"

WORKDIR /src
COPY . .
RUN pip install --no-cache-dir . pytest

CMD ["sh", "docker/run-tests.sh"]
